# Local development only. npm run dev reads .env; never commit your real .env.
# Keep both services bound to 127.0.0.1 while demo role creation is enabled.
DEMO_MODE=true
# Hosted deployments: DEMO_MODE=false, PostgreSQL required; see docs/deployment-vercel.md.
# DATABASE_URL=postgresql://... (use your provider's pooled SSL connection string)
# CRON_SECRET= (random value of at least 32 characters, backend only)
# Frontend build only: the backend origin, without /api or /v1.
# VITE_API_BASE_URL=https://your-api-project.vercel.app
# Default when omitted: <project>/data/sachet.sqlite3
# SACHET_DB_PATH=

# Optional cloud routes. Select a model actually available in your free account
# that supports the adapter's JSON-schema response mode. No model is presumed
# free, approved, or quality-validated merely by entering its identifier.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Shared local request cap across both providers. Each request has bounded input
# and output. This cap does not replace provider-side billing/usage controls.
SACHET_CLOUD_DAILY_REQUEST_LIMIT=40

# Optional real Razorpay TEST account. Live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional allowed browser origins; never use a wildcard for deployment.
SACHET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
